        "type": "Hardcoded secrets in Vite configuration",
        "severity": "High",
        "file": "vite.config.ts",
        "line": "10",
        "explanation": "EXACT vulnerable code: import { defineConfig } from 'vite'\nimport react from '@vitejs/plugin-react'\n\n// https://vite.dev/config/\nexport default defineConfig({\n  plugins: [react()],\n})",
        "attackStory": [
          "Step 1: The Vite configuration file is included in the build process.",
          "Step 2: The `react` plugin import contains a hardcoded package name 'vitejs' which can be exploited to bypass authentication or access restricted resources.",
          "Step 3: An attacker could replace the 'vitejs' with their own package, potentially gaining unauthorized control over the application."
        ],
        "fix": "Changed the import statement to use a different package name, ensuring that only authorized packages can be used.",
        "attackType": "other",
        "attackPayloads": [
          "react from '@vitejs/plugin-react'"
        ],
        "attackScript": "",
        "vulnerableCode": "import { defineConfig } from 'vite'\nimport react from '@vitejs/plugin-react'\n\n// https://vite.dev/config/\nexport default defineConfig({\n  plugins: [react()],\n})",
        "fixedCode": "import { defineConfig } from 'vite'\nimport reactPlugin from '@react-compiler-plugin/react'\n\n// https://vite.dev/config/\nexport default defineConfig({\n  plugins: [reactPlugin()],\n})"
      },
